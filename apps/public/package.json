{
  "name": "@katrix/public",
  "version": "0.0.0",
  "private": true,
  "description": "The public test server (v0): GitHub login, Postgres, no federation",
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "predev": "npm run build -w @katrix/server",
    "dev": "node src/dev.ts",
    "secrets": "msecrets",
    "deploy": "msecrets run -e production -- docker compose -f compose.prod.yaml up -d --build",
    "tunnel": "sh scripts/tunnel.sh"
  },
  "dependencies": {
    "@katrix/server": "*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@katrix/dev-idp": "*",
    "@msecrets/ui": "4.0.0",
    "@types/pg": "8.23.1"
  }
}
