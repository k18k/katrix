{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 140,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/dist/**",
    "package-lock.json",
    "packages/core/complement/results.json",
    "packages/core/complement/passing.txt",
    "CLAUDE-SECURITY-*/**",
    "*.md",
    "**/msecrets.json"
  ]
}
