{
  "name": "matrix-nodejs-homeserver-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "smoke": "npm run smoke -w matrix-nodejs-homeserver && npm test -w @matrix-nodejs-homeserver/public",
    "build": "npm run build --workspaces --if-present",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "changeset": "changeset",
    "version-packages": "changeset version && oxfmt packages/*/package.json",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
