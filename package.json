{
  "name": "matrix-nodejs-homeserver",
  "version": "0.2.0",
  "description": "A framework- and database-agnostic Matrix homeserver library for Node.js",
  "keywords": [
    "chat",
    "e2ee",
    "federation",
    "homeserver",
    "matrix"
  ],
  "homepage": "https://github.com/k18k/matrix-nodejs-homeserver#readme",
  "bugs": {
    "url": "https://github.com/k18k/matrix-nodejs-homeserver/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k18k/matrix-nodejs-homeserver.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "build": "tsdown",
    "prepare": "npm run build",
    "start:example": "node examples/node-http.ts",
    "start:multi-node-example": "node examples/multi-node.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && oxfmt package.json",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=26"
  }
}
