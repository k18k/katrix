{
  "name": "@katrix/server",
  "version": "0.4.3",
  "description": "Katrix: a framework- and database-agnostic Matrix homeserver library for Node.js",
  "keywords": [
    "chat",
    "e2ee",
    "federation",
    "homeserver",
    "matrix"
  ],
  "homepage": "https://github.com/k18k/katrix/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/k18k/katrix/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k18k/katrix.git",
    "directory": "packages/server"
  },
  "files": [
    "AUDITBOT.md",
    "PRODUCTION.md",
    "SPEC-COVERAGE.md",
    "LICENSE",
    "README.md",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*.ts": {
      "matrix-src": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auditbot": {
      "types": "./dist/auditbot/index.d.ts",
      "default": "./dist/auditbot/index.js"
    }
  },
  "peerDependencies": {
    "@matrix-org/matrix-sdk-crypto-nodejs": "^0.6.6"
  },
  "peerDependenciesMeta": {
    "@matrix-org/matrix-sdk-crypto-nodejs": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
