{
  "name": "@katrix/server",
  "version": "0.3.10",
  "description": "Katrix: a framework- and database-agnostic Matrix homeserver library for Node.js",
  "keywords": [
    "chat",
    "e2ee",
    "federation",
    "homeserver",
    "matrix"
  ],
  "homepage": "https://github.com/k18k/katrix/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/k18k/katrix/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k18k/katrix.git",
    "directory": "packages/server"
  },
  "files": [
    "AUDITBOT.md",
    "PRODUCTION.md",
    "SPEC-COVERAGE.md",
    "LICENSE",
    "README.md",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*.ts": {
      "matrix-src": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auditbot": {
      "types": "./dist/auditbot/index.d.ts",
      "default": "./dist/auditbot/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=matrix-src --test \"test/**/*.test.ts\"",
    "smoke": "node --conditions=matrix-src --test test/smoke.test.ts",
    "build": "tsdown",
    "prepare": "node -e \"process.exit(process.env.KATRIX_TSDOWN ? 0 : 1)\" || npm run build",
    "start:example": "node --conditions=matrix-src examples/node-http.ts",
    "start:multi-node-example": "node --conditions=matrix-src examples/multi-node.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@better-auth/core": "1.7.12",
    "@better-auth/oauth-provider": "1.7.12",
    "@better-auth/utils": "0.5.0",
    "@better-fetch/fetch": "1.3.2",
    "@matrix-org/matrix-sdk-crypto-nodejs": "0.6.6",
    "better-auth": "1.7.12",
    "better-call": "1.4.4",
    "pg": "8.23.1",
    "publint": "^0.3.25"
  },
  "peerDependencies": {
    "@matrix-org/matrix-sdk-crypto-nodejs": "^0.6.6"
  },
  "peerDependenciesMeta": {
    "@matrix-org/matrix-sdk-crypto-nodejs": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
