{
  "name": "@katrix/client",
  "version": "0.3.10",
  "description": "Katrix client: a Matrix client SDK in TypeScript with end-to-end encryption (Olm, Megolm) for Node.js, browsers and React Native",
  "keywords": [
    "client",
    "e2ee",
    "matrix",
    "megolm",
    "olm",
    "react-native"
  ],
  "homepage": "https://github.com/k18k/katrix/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/k18k/katrix/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k18k/katrix.git",
    "directory": "packages/client"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "node --conditions=matrix-src --test \"test/unit/**/*.test.ts\" \"test/crypto/**/*.test.ts\" \"test/integration/**/*.test.ts\" && npm run test:hermes",
    "test:hermes": "node --conditions=matrix-src --import ./test/env/hermes.ts --test \"test/hermes/**/*.test.ts\" \"test/crypto/olm.test.ts\" \"test/crypto/megolm.test.ts\" \"test/unit/storage.test.ts\" \"test/unit/models.test.ts\"",
    "build": "tsdown",
    "prepare": "node -e \"process.exit(process.env.KATRIX_TSDOWN ? 0 : 1)\" || npm run build"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@katrix/server": "*",
    "@katrix/shared": "*",
    "@matrix-org/matrix-sdk-crypto-nodejs": "0.6.6"
  },
  "engines": {
    "node": ">=22"
  }
}
