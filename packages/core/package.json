{
  "name": "matrix-nodejs-homeserver",
  "version": "0.3.7",
  "description": "A framework- and database-agnostic Matrix homeserver library for Node.js",
  "keywords": [
    "chat",
    "e2ee",
    "federation",
    "homeserver",
    "matrix"
  ],
  "homepage": "https://github.com/k18k/matrix-nodejs-homeserver/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/k18k/matrix-nodejs-homeserver/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k18k/matrix-nodejs-homeserver.git",
    "directory": "packages/core"
  },
  "files": [
    "AUDITBOT.md",
    "PRODUCTION.md",
    "SPEC-COVERAGE.md",
    "LICENSE",
    "README.md",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auditbot": {
      "types": "./dist/auditbot/index.d.ts",
      "default": "./dist/auditbot/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "smoke": "node --test test/smoke.test.ts",
    "build": "tsdown",
    "check:package": "publint && attw --pack . --profile esm-only",
    "prepare": "npm run build",
    "start:example": "node examples/node-http.ts",
    "start:multi-node-example": "node examples/multi-node.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@better-auth/core": "1.7.6",
    "@better-auth/oauth-provider": "1.7.6",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "1.3.2",
    "@matrix-org/matrix-sdk-crypto-nodejs": "0.6.6",
    "better-auth": "1.7.6",
    "better-call": "1.4.0",
    "pg": "8.23.1",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@matrix-org/matrix-sdk-crypto-nodejs": "^0.6.6"
  },
  "peerDependenciesMeta": {
    "@matrix-org/matrix-sdk-crypto-nodejs": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
